# apps/api 开发期环境变量示例
#
# 用法：复制为同目录下的 .env（`Copy-Item .env.example .env`）后按需修改。
#   - .env 已被 .gitignore 忽略，**不要提交**。
#   - `pnpm dev` 通过 Node 自带的 `--env-file-if-exists=.env` 加载（见 nodemon.json 的 exec）：
#     文件不存在也不报错，所以 CI 与没写 .env 的人都不会炸。
#   - 已在环境里导出的同名变量优先于文件里的值（Node `--env-file` 语义）。

# ---- 必需 ----
# 运行环境：dev | prod。prod 下 MIWO_HOST 必须为 127.0.0.1（由 Nginx 反代）
MIWO_ENV=dev
# HTTP 监听端口（**唯一真相**）。
# ⚠ 自 Task 9 起 `PORT` **不再被读取**：dev 的 10588 与"本机当服务器"的 18080 都由本变量决定，
#   改 `PORT` 不会生效（历史上两者并存，正是"改了没生效"的来源）。
MIWO_PORT=10588
# 监听地址：本机开发固定 127.0.0.1
MIWO_HOST=127.0.0.1
# 数据根（相对路径按**进程 cwd** 解析；从 apps/api 跑 `pnpm dev` 时即 apps/api/data）
MIWO_DATA_DIR=./data
# JWT 签名密钥，**至少 32 字节**；示例值仅供本机开发，生产必须换成随机长密钥
MIWO_JWT_SECRET=dev-only-secret-at-least-32-bytes-long

# ---- 可选 ----
# 媒体目录，默认 <MIWO_DATA_DIR>/oss
# MIWO_MEDIA_DIR=
# 存储后端：local | s3，默认 local
# MIWO_STORAGE_DRIVER=local
# 反向代理跳数，默认 dev=0 / prod=1；空值或纯空白按"未设置"处理
# MIWO_TRUST_PROXY=0
# 对外可访问的基地址；dev 默认 http://<MIWO_HOST>:<MIWO_PORT>
# 从 Task 9 起：prod 必填 MIWO_PUBLIC_BASE_URL
# MIWO_PUBLIC_BASE_URL=http://127.0.0.1:10588
# 数据库：sqlite（默认，文件为 <MIWO_DATA_DIR>/db2.sqlite）| mysql
# sqlite 是默认值，无需设置任何 DB_* 变量；改用 mysql 时**必须同时**给出下面 8 项中的
# HOST/PORT/USER/NAME（PASSWORD 允许为空），否则启动即抛 ConfigError。
# MIWO_DB_DRIVER=mysql
# MIWO_DB_HOST=127.0.0.1
# MIWO_DB_PORT=3306
# MIWO_DB_USER=miwo
# MIWO_DB_PASSWORD=
# MIWO_DB_NAME=miwo
# 连接池：默认 min=2 / max=20
# MIWO_DB_POOL_MIN=2
# MIWO_DB_POOL_MAX=20
