node_modules/
dist/
build/
*.log
*.tmp
.tmp-*

# Agent/SDD 工作区（git-ignored scratch）
.superpowers/

# 宿主相关的冻结基线
tools/.phase0-old-baseline.json

# 环境与密钥
.env
.env.local
.env.prod

# 部署证书与私钥（修复轮 1，F7）：deploy/README.md 让运维把 fullchain.pem/privkey.pem 放进 deploy/certs/，
# 而本仓工作流是 `git add -A` —— 不加这几条，**私钥会被直接提交**。
# deploy/certs/ 只是仓库内的暂存位置；正式部署建议直接放 /etc/nginx/certs/。
deploy/certs/
*.pem
*.key

# 运行时数据（保留 data/skills、data/modelPrompt、data/vendor）
apps/api/data/oss/
apps/api/data/serve/
apps/api/data/web/
apps/api/data/models/
apps/api/data/redraw-prep/
apps/api/data/assets/
apps/api/data/db2.sqlite
apps/api/data/db2.sqlite-*
apps/api/data/version.txt

# Phase 1a：数据搬迁的中间产物（导出物 / 导入报告 / 比对报告），绝不入库。
# ⚠ 导出物里含**真凭据**（老库 `o_vendorConfig` 的 inputValues 存着 API key）与全部业务数据，
#    必须当成密钥对待：只留在本机、用完删。上面的 `.tmp-*` 已经覆盖它，这里显式再写一条，
#    免得日后有人收紧那条通配规则时把它放进来。
apps/api/.tmp-migrate/

# 构建/部署临时
.tmp-build/
.tmp-esbuild/
