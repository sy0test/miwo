# 谜沃 worker（Phase 1d 起是**真单元**：产物 data/serve/worker.js 由 `pnpm --filter @miwo/api build` 产出）
# 前置（与 api 单元相同）：仓库根 `pnpm install` + `pnpm --filter @miwo/api build`；
#   数据卷首次播种见 deploy/README.md（缺 vendor/skills/modelPrompt 时功能会静默失效）。
# ⚠ 产物路径口径与 api 一致：data/serve/*.js（绝不是 dist/*.js，仓库里没有任何以 dist 为 outfile 的构建）。
[Unit]
Description=miwo worker (leased job queue runner)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=miwo
WorkingDirectory=/opt/miwo/apps/api
EnvironmentFile=/etc/miwo/env
ExecStart=/usr/bin/node data/serve/worker.js
# 优雅停机：worker 收到 SIGTERM 后会在 JOB_POLICY.shutdownGraceMs（默认 25s）内等在跑任务收尾，再强 abort。
# TimeoutStopSec 必须 > shutdownGraceMs，否则 systemd 会提前 SIGKILL（租约会靠 reclaimExpired 兜住，
# 但那是次优路径：任务要重跑一遍）。
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
