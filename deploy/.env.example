# 谜沃 / MirrorWorld 部署环境变量（spec §4.3）
# 复制为 .env 后按实际情况填写。所有 MIWO_* 变量的权威定义在 apps/api/src/config.ts。

# ---- 运行环境（必填）----
# dev | prod。prod 下 MIWO_HOST 必须是 127.0.0.1（apps/api/src/config.ts:84-86 强制，否则启动抛 ConfigError），
# 且必须设置 MIWO_PUBLIC_BASE_URL。
MIWO_ENV=prod
# ⚠ 改本值必须同步改 deploy/nginx.conf 里 **3 处** proxy_pass（/api、/oss、/socket.io）；
#   tools/check-deploy-config.cjs 会逐处断言"nginx 的端口 == 本值"，不一致直接失败。
MIWO_PORT=10588
MIWO_HOST=127.0.0.1

# ---- 路径（必填）----
# 数据根：媒体、运行时文件和 web 静态产物都在这下面（nginx root = ${MIWO_DATA_DIR}/web）。
# Docker 将同一路径 bind mount 到容器，供 1Panel nginx 与 API 共用。
# 首次启动会播种 apps/api/data 的 skills/modelPrompt；细节见 deploy/README.md。
MIWO_DATA_DIR=/var/lib/miwo/data
# 媒体根，缺省为 ${MIWO_DATA_DIR}/oss
MIWO_MEDIA_DIR=/var/lib/miwo/data/oss
# local | s3（S3 启用时需填写下面的 S3 连接配置）
MIWO_STORAGE_DRIVER=local
# S3-compatible endpoint 配置；path-style 适用于 MinIO 等自托管服务
MIWO_S3_BUCKET=
MIWO_S3_REGION=
MIWO_S3_ENDPOINT=
MIWO_S3_ACCESS_KEY_ID=
MIWO_S3_SECRET_ACCESS_KEY=
MIWO_S3_SESSION_TOKEN=
MIWO_S3_FORCE_PATH_STYLE=false

# ---- 对外地址（prod 必填）----
# ⚠ 使用条件（Task 9 起）：dev 缺省是 http://<MIWO_HOST>:<MIWO_PORT>（即 127.0.0.1），
#   Task 9 删掉了"回退到第一个非回环 IPv4"的旧逻辑（apps/api/src/utils/oss.ts 的 lanMediaBase）。
#   所以 **dev + 局域网/手机浏览器** 访问时必须显式设成本机局域网地址（如 http://192.168.1.12:10588），
#   否则远端浏览器会把 127.0.0.1 当成它自己 → 媒体（/oss）全部加载失败。
#   MIWO_ENV=prod 不受影响：媒体走相对路径，本变量用于生成对外绝对链接。
MIWO_PUBLIC_BASE_URL=https://your-domain.example
# 反向代理层数，prod 缺省 1
MIWO_TRUST_PROXY=1

# ---- 密钥（必填，至少 32 字节）----
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MIWO_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random

# ---- 数据库（**Phase 1a 起真正生效**）----
# sqlite | mysql。缺省 sqlite（=${MIWO_DATA_DIR}/db2.sqlite）。
# ⚠ Phase 1a 之前：这一组变量只在 config.ts 里被读取，utils/db.ts 写死 better-sqlite3 → **不生效**。
#   Phase 1a 起：client 由 MIWO_DB_DRIVER 装配（apps/api/src/db/connect.ts）；
#   启动序列 = 连接 → knex migrate.latest() → 监听端口（迁移失败即 fail-fast 退出）。
#   —— 生产环境上线顺序必须是「备份 → 迁移 → 起服务」；迁移由容器入口/服务启动时自动执行（幂等）。
MIWO_DB_DRIVER=mysql
# Docker 的 api/worker 使用 host 网络，连接 1Panel 管理的宿主机 MySQL。
# 若 1Panel 映射端口不是本机回环 3306，在这里填写实际可从宿主机访问的地址和端口。
MIWO_DB_HOST=127.0.0.1
MIWO_DB_PORT=3306
MIWO_DB_USER=miwo
MIWO_DB_PASSWORD=replace-me
MIWO_DB_NAME=miwo
# 连接池：缺省 min=2 / max=20（config.ts 校验 poolMax >= poolMin >= 1）
MIWO_DB_POOL_MIN=2
MIWO_DB_POOL_MAX=20
# 连接级不变式（不是环境变量，写死在 apps/api/src/db/connect.ts）：
#   charset=utf8mb4 · timezone=+08:00 · supportBigNumbers=true · bigNumberStrings=false
# 字符集/排序规则/时区由库级与连接级共同保证（spec §5.3）；数据库必须建成 utf8mb4 / utf8mb4_0900_ai_ci。
# ⚠ 数据库结构由版本化迁移建出（apps/api/src/db/migrations/）；平台种子 `seed/*.ndjson` 随 prod 产物一起进容器
#   （`apps/api/scripts/build.ts` 会拷到 data/serve/migrations/seed/ 与 data/serve/seed/，源目录缺失即构建失败）。

# ---- 外部二进制与外部脚本（**Phase 1c Task 10 新增**；可选，缺省见 apps/api/src/config.ts）----
# ffmpeg / ffprobe 的可执行文件名或绝对路径。容器镜像需自行安装 ffmpeg（本机无 Docker ⇒ 该项**未实测**；
# 本机开发不装则相关功能报"找不到 ffmpeg"，不影响启动）。
MIWO_FFMPEG_PATH=ffmpeg
MIWO_FFPROBE_PATH=ffprobe
# 单条 ffmpeg 命令超时（毫秒）
MIWO_FFMPEG_TIMEOUT_MS=600000
# 转绘本地 ASR（faster-whisper；M1 起取代已删除的 MIWO_REDRAW_PREP 外部脚本）。
# 镜像在构建阶段装好 venv 与模型（deploy/Dockerfile 的 asr-deps / runtime 阶段），运行时**不联网**。
MIWO_ASR_DRIVER=local
MIWO_ASR_MODEL=medium
MIWO_ASR_MODEL_DIR=/app/apps/api/asr/models
MIWO_ASR_COMPUTE=int8
MIWO_ASR_PYTHON=/app/apps/api/asr/.venv/bin/python
MIWO_ASR_SCRIPT=/app/apps/api/asr/transcribe.py
MIWO_ASR_TIMEOUT_MS=1200000
# 拼贴图标签字体（运行层已装 fonts-dejavu-core；G10：标签只含 ASCII，不需要 CJK 字体）
MIWO_GRID_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# 出网代理。**旧名 `TOONFLOW_PROXY` 已在 Phase 1c 废弃**（不再读取）；空 = 直连 / 读标准代理变量
# （`HTTPS_PROXY`/`HTTP_PROXY` 及其小写形式 —— undici 的 EnvHttpProxyAgent 只认这四个标准名）。
MIWO_PROXY=
# 媒体 URL 前缀覆盖（空 = 相对路径 / dev 与 Electron 的既有规则；填了会改所有 /oss、/assets 链接的前缀）
MIWO_OSS_URL=

# ---- 容器编排用（非应用代码读取）----
MIWO_IMAGE_TAG=latest
# 转绘本地 ASR 的构建参数（docker compose build 传给 deploy/Dockerfile）
# ⚠ 生产请把 ASR_MODEL_REVISION 钉到 HuggingFace 上该模型仓的具体 commit；main = 不可复现但能构建。
ASR_MODEL=medium
ASR_MODEL_REVISION=main