# 谜沃 / MirrorWorld 部署环境变量（spec §4.3）
# 复制为 .env 后按实际情况填写。所有 MIWO_* 变量的权威定义在 apps/api/src/config.ts。

# ---- 运行环境（必填）----
# dev | prod。prod 下 MIWO_HOST 必须是 127.0.0.1，且必须设置 MIWO_PUBLIC_BASE_URL
MIWO_ENV=prod
MIWO_PORT=10588
MIWO_HOST=127.0.0.1

# ---- 路径（必填）----
# 数据根：数据库、媒体、运行时文件都在这下面
MIWO_DATA_DIR=/var/lib/miwo/data
# 媒体根，缺省为 ${MIWO_DATA_DIR}/oss
MIWO_MEDIA_DIR=/var/lib/miwo/data/oss
# local | s3（s3 在 Phase 2 实现）
MIWO_STORAGE_DRIVER=local

# ---- 对外地址（prod 必填）----
# ⚠ 使用条件（Task 9 起）：dev 缺省是 http://<MIWO_HOST>:<MIWO_PORT>（即 127.0.0.1），
#   Task 9 删掉了"回退到第一个非回环 IPv4"的旧逻辑（apps/api/src/utils/oss.ts 的 lanMediaBase）。
#   所以 **dev + 局域网/手机浏览器** 访问时必须显式设成本机局域网地址（如 http://192.168.1.12:10588），
#   否则远端浏览器会把 127.0.0.1 当成它自己 → 媒体（/oss）全部加载失败。
#   MIWO_ENV=prod 不受影响：媒体走相对路径，本变量用于生成对外绝对链接。
MIWO_PUBLIC_BASE_URL=https://your-domain.example
# 反向代理层数，prod 缺省 1
MIWO_TRUST_PROXY=1

# ---- 密钥（必填，至少 32 字节）----
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MIWO_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random

# ---- 数据库（Phase 1a 起使用）----
# sqlite | mysql
MIWO_DB_DRIVER=mysql
MIWO_DB_HOST=mysql
MIWO_DB_PORT=3306
MIWO_DB_USER=miwo
MIWO_DB_PASSWORD=replace-me
MIWO_DB_NAME=miwo
MIWO_DB_POOL_MIN=2
MIWO_DB_POOL_MAX=20

# ---- 容器编排用（非应用代码读取）----
MIWO_MYSQL_ROOT_PASSWORD=replace-me
MIWO_IMAGE_TAG=latest
