{
  "name": "miwo",
  "private": true,
  "version": "0.1.0",
  "description": "谜沃 / MirrorWorld — 多租户 AI 短剧生产平台",
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "sqlite3",
      "onnxruntime-node"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify:copy": "node tools/check-copy.cjs",
    "verify:dead-ddl": "node tools/check-dead-ddl.cjs",
    "verify:brand": "node tools/check-brand.cjs",
    "verify:deploy": "node tools/check-deploy-config.cjs",
    "verify:auth-writers": "node tools/check-authenticated-writers.cjs",
    "verify:phase0": "node apps/api/scripts/verify-phase0.cjs",
    "verify:phase1a": "node apps/api/scripts/verify-phase1a.cjs",
    "verify:phase1a:ci": "node apps/api/scripts/verify-phase1a.cjs --ci",
    "verify:phase1b": "node apps/api/scripts/verify-phase1b.cjs",
    "verify:phase1c": "node apps/api/scripts/verify-phase1c.cjs",
    "verify:test-shape": "node tools/check-test-early-return.cjs",
    "verify:build": "node tools/check-build.cjs",
    "verify:config": "node tools/check-config-single-source.cjs",
    "verify:mounts": "node tools/check-non-api-mounts.cjs",
    "verify:phase1c-media": "node apps/api/scripts/verify-phase1c-media.cjs",
    "verify:phase1d": "node apps/api/scripts/verify-phase1d.cjs",
    "verify:legacy-freeze": "node tools/record-legacy-freeze.cjs --check",
    "verify:exceptions": "node tools/check-tenant-exceptions.cjs",
    "verify:exceptions:record": "node tools/check-tenant-exceptions.cjs --record",
    "verify:manual-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manual-test.ps1",
    "verify:policies": "node tools/check-tenant-policies.cjs",
    "verify:mysql-dialect": "node tools/check-mysql-dialect.cjs"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
