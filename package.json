{
  "name": "miwo",
  "private": true,
  "version": "0.1.0",
  "description": "谜沃 / MirrorWorld — 多租户 AI 短剧生产平台",
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "sqlite3",
      "onnxruntime-node"
    ]
  },
  "scripts": {
    "typecheck": "pnpm.cmd -r --if-present typecheck",
    "test": "pnpm.cmd -r --if-present test",
    "verify:copy": "node tools/check-copy.cjs",
    "verify:brand": "node tools/check-brand.cjs",
    "verify:deploy": "node tools/check-deploy-config.cjs",
    "verify:phase0": "node apps/api/scripts/verify-phase0.cjs",
    "verify:exceptions": "node tools/check-tenant-exceptions.cjs",
    "verify:exceptions:record": "node tools/check-tenant-exceptions.cjs --record"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
